<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_margin="12dp" android:background="@drawable/back_smoke_round" android:layout_width="match_parent" android:layout_height="wrap_content">
        <FrameLayout android:background="@drawable/back_black_round" android:layout_margin="12dp" android:layout_width="75dp" android:layout_height="75dp">
            <View android:id="@+id/stateRound" android:layout_gravity="bottom|end" android:layout_width="20dp" android:layout_height="20dp"/>
        </FrameLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/itemName" android:textSize="24sp" android:textColor="@android:color/black" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/itemState" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
