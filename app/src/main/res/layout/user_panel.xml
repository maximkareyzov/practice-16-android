<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/userPanel" android:visibility="gone" android:background="@android:color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageButton android:id="@+id/backButton" android:src="@drawable/ic_back" android:background="@android:color/transparent" android:contentDescription="@string/back" android:layout_margin="16dp" android:layout_width="48dp" android:layout_height="48dp"/>
    <ImageButton android:id="@+id/editButton" android:src="@drawable/ic_edit" android:background="@android:color/transparent" android:contentDescription="@string/edit" android:layout_gravity="top|end" android:layout_margin="16dp" android:layout_width="48dp" android:layout_height="48dp"/>
    <LinearLayout android:orientation="vertical" android:layout_marginTop="80dp" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/NameText" android:id="@+id/panelName" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView style="@style/StateText" android:id="@+id/panelState" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView style="@style/BaseContainer" android:id="@+id/panelAge" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
